# ============================================================================
# Aria Support Portal — environment variables
# Copy to .env.local. EVERYTHING is optional: with no keys the app runs in
# full demo mode (mock Shopify data + rule-based AI + in-memory store).
# ============================================================================

# ---- AI (OpenAI) ----
# Without this, the AI engine uses a deterministic rule-based fallback.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---- Shopify Admin API ----
# Without these, Shopify calls return realistic demo data.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10
SHOPIFY_WEBHOOK_SECRET=
# Public URL of the deployed webhook receiver, used by `npm run register-webhooks`.
WEBHOOK_CALLBACK_URL=https://your-deploy.vercel.app/api/webhooks/shopify

# ---- Supabase (persistence + realtime) ----
# Without these, conversations live in an in-memory store (per-process).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for API routes that write conversations (recommended).
SUPABASE_SERVICE_ROLE_KEY=

# ---- Twilio (existing CRM SMS feature) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
